#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @OPENSTEAMTOOL_VERSION_COMMA@
 PRODUCTVERSION @OPENSTEAMTOOL_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "OpenSteamTool\0"
      VALUE "FileDescription", "OpenSteamTool Steam integration module\0"
      VALUE "FileVersion", "@OPENSTEAMTOOL_VERSION@\0"
      VALUE "InternalName", "OpenSteamTool\0"
      VALUE "OriginalFilename", "OpenSteamTool.dll\0"
      VALUE "ProductName", "OpenSteamTool\0"
      VALUE "ProductVersion", "@OPENSTEAMTOOL_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
